{
  "name": "@magna-protocol/client",
  "version": "0.2.0",
  "description": "Login with Magna connector with chain-bound Aztec authorization verification",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "engines": { "node": ">=24.12.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": { "type": "git", "url": "git+https://github.com/oguzutku1745/magna_monorepo.git", "directory": "packages/magna-client" },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "build:release": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build:release",
    "test": "npm run build && node --test dist/*.spec.js",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "@aztec/aztec.js": "5.1.0",
    "@aztec/constants": "5.1.0",
    "@aztec/foundation": "5.1.0",
    "@magna-protocol/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
