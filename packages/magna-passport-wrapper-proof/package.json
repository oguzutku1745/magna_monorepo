{
  "name": "@magna/passport-wrapper-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "compile:circuit": "${AZTEC_NARGO_BIN:-aztec-nargo} compile --program-dir circuit && node ../../scripts/sync-passport-a2-artifact.mjs",
    "test": "npm run build && node ../../scripts/node-test-runner.mjs 'dist/**/*.spec.js'",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0",
    "@magna/core": "0.1.0",
    "@magna/wallet": "0.1.0",
    "@noir-lang/noir_js": "1.0.0-beta.22",
    "@noir-lang/types": "1.0.0-beta.22",
    "@zkpassport/registry": "0.14.0",
    "@zkpassport/sdk": "0.16.1",
    "@zkpassport/utils": "0.37.3",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "typescript": "^5.9.3"
  }
}
