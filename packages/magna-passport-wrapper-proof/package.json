{
  "name": "@magna/passport-wrapper-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./safe": {
      "types": "./dist/safe.d.ts",
      "import": "./dist/safe.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./browser-bb": {
      "types": "./dist/browser-bb.d.ts",
      "import": "./dist/browser-bb.js"
    },
    "./recursive": {
      "types": "./dist/recursive.d.ts",
      "import": "./dist/recursive.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "compile:circuit:production": "${AZTEC_NARGO_BIN:-aztec-nargo} compile --program-dir circuit && node ../../scripts/sync-passport-a2-artifact.mjs --profile=production",
    "compile:circuit:development": "${AZTEC_NARGO_BIN:-aztec-nargo} compile --program-dir circuit-dev && node ../../scripts/sync-passport-a2-artifact.mjs --profile=development",
    "compile:circuit": "npm run compile:circuit:production && npm run compile:circuit:development",
    "test": "npm run build && node ../../scripts/node-test-runner.mjs 'dist/**/*.spec.js'",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0",
    "@magna-protocol/core": "0.1.1",
    "@magna/wallet": "0.1.0",
    "@noir-lang/noir_js": "1.0.0-beta.22",
    "@noir-lang/types": "1.0.0-beta.22",
    "@zkpassport/registry": "0.14.0",
    "@zkpassport/utils": "0.37.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "typescript": "^5.9.3"
  }
}
