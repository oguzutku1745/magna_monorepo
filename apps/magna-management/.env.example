VITE_AZTEC_NODE_URL=http://localhost:8080
VITE_MAGNA_APP_ID=magna-management
VITE_MAGNA_DEPLOYMENT_PROFILE=development
VITE_MAGNA_VERIFICATION_API_URL=http://localhost:4310
VITE_MAGNA_ZKPASSPORT_REQUEST_NAME=Magna
VITE_MAGNA_ZKPASSPORT_REQUEST_LOGO=https://magna.identity/logo.png
VITE_MAGNA_ZKPASSPORT_REQUEST_PURPOSE="Issue a Magna passport credential using zkPassport verification."
VITE_MAGNA_ZKPASSPORT_REQUEST_SCOPE=magna-passport-onboarding
VITE_MAGNA_ZKPASSPORT_DEV_MODE=true
VITE_MAGNA_ZKPASSPORT_ISSUANCE_KIND=a2
VITE_MAGNA_ZKPASSPORT_PRIMARY_ISSUANCE_MODE=rooted
VITE_MAGNA_ZKPASSPORT_GHOST_DERIVATION_VERSION=v2_scoped

VITE_MAGNA_ISSUER_ADDRESS=
VITE_MAGNA_COMPANY_SPONSOR_ADDRESS=
VITE_MAGNA_COMPANY_SPONSOR_ADDRESSES=
VITE_MAGNA_ACTIVE_COMPANY_SPONSOR_ADDRESS=
VITE_MAGNA_RIGHTS_REGISTRY_ADDRESS=
VITE_MAGNA_RIGHTS_PURCHASE_L2_ADDRESS=
VITE_MAGNA_L2_PAYMENT_TOKEN_ADDRESS=
VITE_MAGNA_SPONSOR_PROFILE_NAME=local-sponsor
VITE_MAGNA_L1_RPC_URL=
VITE_MAGNA_L1_RIGHTS_PORTAL_ADDRESS=
VITE_MAGNA_L1_PAYMENT_TOKEN_ADDRESS=
VITE_MAGNA_RECOVERY_V3_RELAYER_PRIVATE_KEY=
# Local Gate B-dev only. This key pays for the permissionless portal transaction; it is not a recovery authority.
# The default Anvil key may be used here; never put a production key in a Vite environment.
VITE_MAGNA_LOCAL_FAUCET_PRIVATE_KEY=
# Local chain 31337 only. Enables the UI Fee Juice faucet. It may reuse the disposable Anvil key above.
# The app refuses this faucet on any non-local chain and rejects it under the explicit production profile.
# Recovery V3 contract addresses and network commitments are read from deployments/local.json
# after `npm run recovery-v3:bootstrap:local`.
VITE_MAGNA_ORCHESTRATOR_ADDRESS=
VITE_REFERENCE_DAPP_ORIGIN=http://localhost:5175
VITE_REFERENCE_DAPP_GATEWAY=
VITE_MAGNA_REQUIRE_REAL_SENDS=true
VITE_MAGNA_ENABLE_DEV_ORCHESTRATOR=true
VITE_MAGNA_ENABLE_LOCAL_TEST_BOOTSTRAP=true
VITE_MAGNA_LOCAL_TEST_ACCOUNT_INDEX=0
