MAGNA_VERIFICATION_API_PORT=4310
MAGNA_VERIFICATION_ALLOWED_ORIGIN=http://localhost:5174
MAGNA_ZKPASSPORT_DOMAIN=localhost
# Must match the client's request scope (VITE_MAGNA_ZKPASSPORT_REQUEST_SCOPE) or verify() returns verified=false.
MAGNA_ZKPASSPORT_SCOPE=magna-passport-onboarding
MAGNA_ZKPASSPORT_DEV_MODE=true
# Dev mode verifies mock-passport roots on Sepolia. Use your own Sepolia RPC in production-like testing.
MAGNA_ZKPASSPORT_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAGNA_AZTEC_NODE_URL=http://localhost:8080
MAGNA_ISSUER_ADDRESS=
MAGNA_LOCAL_TEST_ACCOUNT_INDEX=0
MAGNA_ORCHESTRATOR_ADDRESS=
# Comma-separated Noir-field hashes of governed Instagram DKIM public keys.
# This local value is the independently DNS-captured key used by the committed real-email fixture.
MAGNA_INSTAGRAM_DKIM_PUBKEY_HASHES=0x2f98bb0fd5d8e691af9dd90027c769678ac017a689173593d6edc98faa01c952
