VITE_AZTEC_NODE_URL=http://127.0.0.1:8080
VITE_MAGNA_APP_ID=magna-web
VITE_MAGNA_VERIFICATION_API_URL=http://localhost:4310
VITE_MAGNA_ZKPASSPORT_REQUEST_NAME=Magna
VITE_MAGNA_ZKPASSPORT_REQUEST_LOGO=https://magna.identity/logo.png
VITE_MAGNA_ZKPASSPORT_REQUEST_PURPOSE=Issue a Magna passport credential using zkPassport verification.
VITE_MAGNA_ZKPASSPORT_REQUEST_SCOPE=magna-passport-onboarding
VITE_MAGNA_ZKPASSPORT_DEV_MODE=true
# Canonical onboarding mode is rooted. Set to "passport" only for legacy compatibility/debug.
VITE_MAGNA_ZKPASSPORT_PRIMARY_ISSUANCE_MODE=rooted
# Canonical ghost derivation is scoped (v2). Keep v1 only for legacy recovery compatibility.
VITE_MAGNA_ZKPASSPORT_GHOST_DERIVATION_VERSION=v2_scoped

# Core Magna contracts (required for user verify path)
VITE_MAGNA_ISSUER_ADDRESS=0x27aa5ca2da323f8e7acd9694cbb45d22d9b8bceb3a1eaf975c150a2dcb1ae7cf
# Legacy single-sponsor alias (kept for backward compatibility)
VITE_MAGNA_COMPANY_SPONSOR_ADDRESS=0x15233c81c25a2f2d0cb9a5a282d89032a15d85d6e14827c2aac1c27430a90b54
# Preferred multi-sponsor configuration (canonical frontend source)
# Comma-separated Aztec addresses, e.g. 0xaaa,0xbbb
VITE_MAGNA_COMPANY_SPONSOR_ADDRESSES=0x15233c81c25a2f2d0cb9a5a282d89032a15d85d6e14827c2aac1c27430a90b54
# Optional default selection from the configured sponsor list
VITE_MAGNA_ACTIVE_COMPANY_SPONSOR_ADDRESS=0x15233c81c25a2f2d0cb9a5a282d89032a15d85d6e14827c2aac1c27430a90b54

# Operator rights surface (required for L2 top-up path)
VITE_MAGNA_RIGHTS_REGISTRY_ADDRESS=0x2e60f10cb89b3dcc0be0c8e8f7e230befa597c7927321d73da9db08f935fc8f1
VITE_MAGNA_RIGHTS_PURCHASE_L2_ADDRESS=0x21e22447820e24d7fa89463757a6331daf790b7608434680b706c395ce89a404
VITE_MAGNA_L2_PAYMENT_TOKEN_ADDRESS=0x16f0380cc24fff1358043650659e43bfbcd1bc440abbf8b40dd53453b50f117d
VITE_MAGNA_SPONSOR_PROFILE_NAME=local-sponsor

# Primary L1 funding path (local-dev operator flow):
# - approve payment token on L1
# - purchase rights through MagnaRightsPortal
# - claim credit on L2 rights registry
VITE_MAGNA_L1_RPC_URL=http://127.0.0.1:8545
VITE_MAGNA_L1_RIGHTS_PORTAL_ADDRESS=0xb9a62f59f8c1359e24830e4fd209954e21b7df37
VITE_MAGNA_L1_PAYMENT_TOKEN_ADDRESS=0x95401dc811bb5740090279ba06cfa8fcf6113778
# Local-dev only. Never use a production private key in frontend env.
VITE_MAGNA_L1_BUYER_PRIVATE_KEY=

# Optional sender registration (local dev orchestrator/test account)
VITE_MAGNA_ORCHESTRATOR_ADDRESS=0x13aaeade7d4d8a9a83d2ed31281c2d673816743a189928bcef0e8e30cb292854

# Wallet-sdk discovery hardening
VITE_MAGNA_WALLET_DISCOVERY_TIMEOUT_MS=60000
VITE_MAGNA_WALLET_EXTENSION_ALLOW_LIST=
VITE_MAGNA_WALLET_EXTENSION_BLOCK_LIST=

# Readiness policy: keep true for all critical browser checks
VITE_MAGNA_REQUIRE_REAL_SENDS=true

# Local/dev-only toggles
VITE_MAGNA_ENABLE_MANAGED_WALLETS=true
VITE_MAGNA_ENABLE_DEV_ORCHESTRATOR=true
VITE_MAGNA_ENABLE_LOCAL_TEST_BOOTSTRAP=true
VITE_MAGNA_LOCAL_TEST_ACCOUNT_INDEX=0
