{
  "name": "magna-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Magna v1 monorepo (Aztec private credential layer)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "network:local": "./scripts/start-local-network.sh",
    "docker:local": "node ./scripts/start-docker-local.mjs",
    "docker:local:resume": "docker compose start anvil aztec-localnet verification-api management reference-dapp",
    "docker:local:refresh-frontends": "docker compose up --no-build --detach --no-deps --force-recreate management reference-dapp",
    "docker:local:rebuild": "docker compose up --build --detach",
    "docker:local:down": "docker compose down --volumes --remove-orphans",
    "docker:local:config": "docker compose config --quiet",
    "localnet:drift": "node ./scripts/check-localnet-drift.mjs",
    "build": "npm run -ws build",
    "test": "npm run -ws test",
    "lint": "npm run -ws lint",
    "verification-api:dev": "npm run -w @magna/verification-api dev",
    "readiness:passport-a2": "node ./scripts/passport-a2-readiness.mjs",
    "instagram-proof:prepare": "npm run -w @magna/instagram-proof build && npm run -w @magna/instagram-proof compile:circuit",
    "test:instagram-proof": "npm run instagram-proof:prepare && npm run -w @magna/instagram-proof test && npm run -w @magna/instagram-proof test:proof",
    "test:instagram-proof:docker": "docker run --rm --entrypoint sh magna-local-app:aztec-5.1.0 -lc 'cd /workspace && NARGO_BIN=/usr/local/bin/nargo-instagram npm run -w @magna/instagram-proof compile:circuit && npm run -w @magna/instagram-proof test && npm run -w @magna/instagram-proof test:proof'",
    "test:reviewer:critical": "node ./scripts/run-reviewer-critical-tests.mjs",
    "test:reviewer:critical:docker": "docker run --rm --entrypoint sh magna-local-app:aztec-5.1.0 -lc 'cd /workspace && npm run test:reviewer:critical'",
    "bootstrap:local": "node ./scripts/bootstrap-local-apps-wrapper.mjs",
    "web:bootstrap:local": "npm run bootstrap:local",
    "fund:fee-juice": "node ./scripts/fund-fee-juice.mjs",
    "vectors:sync": "node ./scripts/sync-golden-vectors.mjs",
    "vectors:webauthn": "node ./scripts/gen-webauthn-fixtures.mjs",
    "aztec:version": "VERSION=5.1.0 aztec --version",
    "compile:issuer": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-issuer",
    "compile:company-rights-registry": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-company-rights-registry",
    "compile:company-sponsor": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-company-sponsor",
    "compile:verify-meter-hook": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-verify-meter-hook",
    "compile:consumer": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-consumer",
    "compile:webauthn-account": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-webauthn-account",
    "compile:verify-meter-hook-instant": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-verify-meter-hook-instant",
    "compile:rights-purchase-l2": "node ./scripts/aztec-tooling.mjs compile ./contracts/magna-rights-purchase-l2",
    "compile:contracts": "npm run compile:issuer && npm run compile:company-rights-registry && npm run compile:company-sponsor && npm run compile:verify-meter-hook && npm run compile:consumer && npm run compile:verify-meter-hook-instant && npm run compile:rights-purchase-l2 && npm run compile:webauthn-account",
    "magna:testnet": "node ./scripts/magna-testnet-validate.mjs",
    "test:contracts:verify-meter-hook": "node ./scripts/aztec-tooling.mjs test ./contracts/magna-verify-meter-hook",
    "test:contracts:issuer": "node ./scripts/aztec-tooling.mjs test ./contracts/magna-issuer",
    "test:contracts:company-rights-registry": "node ./scripts/aztec-tooling.mjs test ./contracts/magna-company-rights-registry",
    "test:contracts:company-sponsor": "node ./scripts/aztec-tooling.mjs test ./contracts/magna-company-sponsor",
    "test:contracts:webauthn": "node ./scripts/aztec-tooling.mjs test ./contracts/magna-webauthn",
    "test:contracts:webauthn-account": "node ./scripts/aztec-tooling.mjs test ./contracts/magna-webauthn-account",
    "test:client": "npm run -w @magna/client test",
    "test:wallet": "npm run -w @magna/wallet test",
    "test:recovery-v3": "npm run -w @magna/recovery-v3 test && npm run -w @magna/recovery-v3 test:noir",
    "test:recovery-portal": "cd contracts/magna-recovery-portal && forge test",
    "recovery-v3:compile-wrapper": "npm run -w @magna/recovery-wrapper-proof compile:circuit",
    "recovery-v3:generate-verifier": "npm run -w @magna/recovery-wrapper-proof generate:solidity-verifier",
    "recovery-v3:sync-zkpassport-registry": "node ./scripts/sync-zkpassport-registry-source.mjs",
    "recovery-v3:bootstrap:local": "node ./scripts/bootstrap-recovery-v3-local.mjs",
    "recovery-v3:measure-wrapper": "node ./scripts/measure-recovery-wrapper.mjs",
    "test:ci": "npm run vectors:sync && npm run test:contracts:verify-meter-hook && npm run test:contracts:issuer && npm run test:contracts:company-rights-registry && npm run test:contracts:company-sponsor && npm run test:contracts:webauthn && npm run test:contracts:webauthn-account && npm run test:core && npm run test:wallet && npm run test:client",
    "codegen:issuer": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-issuer ./packages/contracts-bindings/src",
    "codegen:company-rights-registry": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-company-rights-registry ./packages/contracts-bindings/src",
    "codegen:company-sponsor": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-company-sponsor ./packages/contracts-bindings/src",
    "codegen:verify-meter-hook": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-verify-meter-hook ./packages/contracts-bindings/src",
    "codegen:consumer": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-consumer ./packages/contracts-bindings/src",
    "codegen:webauthn-account": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-webauthn-account ./packages/contracts-bindings/src",
    "codegen:verify-meter-hook-instant": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-verify-meter-hook-instant ./packages/contracts-bindings/src",
    "codegen:rights-purchase-l2": "node ./scripts/aztec-tooling.mjs codegen ./contracts/magna-rights-purchase-l2 ./packages/contracts-bindings/src",
    "codegen:contracts": "npm run codegen:issuer && npm run codegen:company-rights-registry && npm run codegen:company-sponsor && npm run codegen:verify-meter-hook && npm run codegen:consumer && npm run codegen:verify-meter-hook-instant && npm run codegen:rights-purchase-l2 && npm run codegen:webauthn-account",
    "test:core": "npm run -w @magna/core test"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "@zkpassport/registry": "0.14.0",
    "@zkpassport/sdk": "0.16.1",
    "@zkpassport/utils": "0.37.3",
    "react-qr-code": "^2.0.18"
  }
}
